# VERDIX AI — Variables de entorno (copia este archivo a .env y rellena)
# Nunca subas .env con valores reales a control de versiones.

# Clave de OpenRouter (DeepSeek, Gemini, Flux) — obligatoria para Verdix AI
OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui

# Modelo OpenRouter por defecto
OPENROUTER_MODEL=deepseek/deepseek-chat

# Puerto del servidor local
VERDIX_PORT=8099

# Límites de uso (configurables)
LIMITE_MENSAJES=5000
LIMITE_VISION=500
LIMITE_IMAGENES_DIA=100
RATE_LIMIT_SEGUNDOS=2

# Firebase (opcional — para login con Google y sincronización en la nube)
# Rellena estos valores en la consola de Firebase: https://console.firebase.google.com
FIREBASE_API_KEY=tu_firebase_api_key
FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu_proyecto_id
FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
FIREBASE_APP_ID=tu_app_id
